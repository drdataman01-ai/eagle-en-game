rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each student's score document lives at /scores/{their auth uid}.
    // Any signed-in user (a logged-in student, or the teacher dashboard's
    // anonymous session) can READ every score doc — that's what lets
    // teacher.html show the whole class. A student can only WRITE their
    // own document, so they can't edit anyone else's score.
    match /scores/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
