rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each student's score document lives at /scores/{their auth uid}.
    // A student can read and write ONLY their own document — they
    // cannot see anyone else's score. The one exception is the fixed
    // teacher account (see TEACHER_EMAIL in firebase-config.js), which
    // can read every document so teacher.html can show the whole class.
    // Nobody except that exact account can read someone else's score.
    match /scores/{userId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == userId ||
                      request.auth.token.email == "teacher@eagle-quest-admin.local");
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
